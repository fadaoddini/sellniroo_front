# کپی کنید به .env.local (لوکال) یا .env.production (بیلد سرور)
# NEXT_PUBLIC_* در زمان build داخل باندل می‌رود — بعد از تغییر حتماً دوباره build کنید.
# اگر این متغیر خالی باشد، پیش‌فرض http://127.0.0.1:8000 است و پنل «سایت‌های سرور» خالی می‌ماند.

# لوکال:
# NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# موتور ربو روی سرور (نمونه):
# NEXT_PUBLIC_API_URL=https://admin.rebo.ir
# NEXT_PUBLIC_SITE_URL=https://rebo.ir
# NEXT_PUBLIC_BACKEND_URL=https://admin.rebo.ir

# فروشگاه/سایت دیگر (نمونه):
# NEXT_PUBLIC_API_URL=https://admin.sellniroo.com

# روی سرور معمولاً نیازی به commit کردن .env.production نیست؛
# install_next / nextoo deploy / nextoo build خودش از DJANGO_DOMAIN می‌سازد.
# درس: /rebolearn → «فرانت و NEXT_PUBLIC_API_URL»
