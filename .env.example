# کپی کنید به .env.local (لوکال) یا .env.production (بیلد سرور)
# NEXT_PUBLIC_* در زمان build داخل باندل می‌رود — بعد از تغییر حتماً دوباره build کنید.
# اگر این متغیر خالی/غلط باشد، /login به localhost وصل می‌شود و ورود روی سرور کار نمی‌کند.

# لوکال:
# NEXT_PUBLIC_API_URL=http://localhost:8000

# سرور (Django شما — همان دامنه‌ای که API روی آن است):
NEXT_PUBLIC_API_URL=https://admin.sellniroo.com

# بعد از ست کردن روی سرور:
#   cd front && npm run build && pm2/systemd restart
# ورود مالک: /login سپس /adminweb (فقط شماره‌های OWNER)
